{
  "manifest_version": 3,
  "name": "xrnmoni web tracker",
  "version": "1.0.1",
  "description": "Reports active-tab page intervals to the local xrnmoni agent (127.0.0.1).",
  "key": "",
  "permissions": ["tabs", "idle", "alarms", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "icons": { "16": "icons/icon16.png", "24": "icons/icon24.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "96": "icons/icon96.png", "128": "icons/icon128.png", "256": "icons/icon256.png" },
  "action": {
    "default_title": "xrnmoni",
    "default_icon": { "16": "icons/icon16.png", "24": "icons/icon24.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "64": "icons/icon64.png", "96": "icons/icon96.png", "128": "icons/icon128.png", "256": "icons/icon256.png" }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "xrnmoni@xrnmoni",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
