{
  "manifest_version": 3,
  "name": "xrnmoni web tracker",
  "version": "1.0.0",
  "description": "Reports active-tab page intervals to the local xrnmoni agent (127.0.0.1).",
  "permissions": ["tabs", "idle", "alarms", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
